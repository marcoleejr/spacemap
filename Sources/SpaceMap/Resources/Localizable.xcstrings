    "fda.granted": {
      "comment": "FDA banner after access was granted",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full Disk Access is on. Rescan to include the folders that were skipped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso total al disco está activado. Vuelve a escanear para incluir las carpetas omitidas."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso total ao disco está ativado. Escaneie de novo para incluir as pastas ignoradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès complet au disque est activé. Relancez l’analyse pour inclure les dossiers ignorés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Voller Festplattenzugriff ist aktiv. Erneut scannen, um übersprungene Ordner einzubeziehen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルディスクアクセスが有効になりました。スキップしたフォルダを含めるには再スキャンしてください。"
          }
        }
      }
    },
